<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>textresource</AssemblyName>
    <RollForward>Major</RollForward>
    <DebugType>embedded</DebugType>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>textresource</ToolCommandName>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BunnyTail.TextResource.Tool</PackageId>
    <Title>BunnyTail.TextResource.Tool</Title>
    <Description>Text resource conversion tool.</Description>
    <PackageTags>tool;resource;localization;csv</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BunnyTail.DependencyInjection" Version="0.10.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
    <PackageReference Include="Usa.Smart.CommandLine.Hosting" Version="2.20.0" />
  </ItemGroup>

</Project>
